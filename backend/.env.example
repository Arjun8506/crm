NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27018/orgcrm
CLIENT_ORIGIN=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Optional ---
# Where uploaded files are stored (local disk driver). Keep it outside the web root and back it up.
STORAGE_DIR=./storage
# Public URL of the web app, used for links inside notification emails and for public form / share links.
APP_URL=http://localhost:5173
# Email delivery. Leave SMTP_URL unset and NO email is sent (the UI says so). Example:
# SMTP_URL=smtps://user:password@smtp.example.com:465
# EMAIL_FROM="OrgCRM <no-reply@example.com>"

# Encrypts integration credentials (Slack/Twilio/SMTP) at rest. Set your own long random value in production.
# SECRETS_KEY=
# Public base URL of this API. Shown to admins as the webhook URLs to give Twilio, and used to verify Twilio signatures.
PUBLIC_API_URL=http://localhost:4000
# Outbound workflow webhooks to private/loopback addresses are blocked (SSRF protection). Only enable this for local development.
# ALLOW_PRIVATE_WEBHOOKS=true
